# Base URL of the parking-management-backend server (no trailing slash).
# Use your machine's LAN IP when testing on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Google OAuth — Web client ID (the SAME one the backend verifies against).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# iOS client ID (optional, iOS builds only)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Reversed iOS client ID; enables the Google Sign-In native config plugin.
# Leave unset until you build a dev client with Google auth.
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id
