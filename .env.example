# Base URL of the parking-management-backend server (no trailing slash).
# Use your machine's LAN IP when testing on a physical device.
API_URL=http://localhost:4000

# Google OAuth — Web client ID (the SAME one the backend verifies against).
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# iOS client ID (optional, iOS builds only)
GOOGLE_IOS_CLIENT_ID=
